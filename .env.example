# Copy this file to .env and fill in real values locally.
# NEVER commit .env. NEVER hardcode secrets in source code.
# See PROJECT_MASTER_PLAN.md section 14 (Configuration, Secrets, Environment).

# --- Environment selector ---
# **Batch H correction (independent audit item 5): no code anywhere in
# src/ or scripts/ reads APP_ENV or LIVE_TRADING from the process
# environment today -- both are aspirational/decorative placeholders,
# not live safety switches.** The real environment selector is
# `BrokerConfig.execution_mode` (an enum passed by the caller
# constructing a session, e.g. `run_paper_trading_cycle.py`'s
# `--paper-store` CLI flow), and the real Live safety switch is
# `LiveTradingConfig.live_trading_enabled` (a dataclass field, likewise
# caller-supplied) -- see `evaluate_safety_gate` in
# `src/broker/live/safety_gate.py`. Setting these two .env values has
# no effect on either.
# One of: development | backtest | paper | live
APP_ENV=development

# Hard safety default. Must be explicitly set to true to allow real broker
# orders. See PROJECT_MASTER_PLAN.md section 14.4.
LIVE_TRADING=false

# --- AI Gateway: provider credentials (references only, not filled here) ---
# Add one variable per provider as providers are actually integrated
# (Phase 12 - AI Gateway). Do not add real keys to this example file.
# AI_PROVIDER_A_API_KEY=
# AI_PROVIDER_B_API_KEY=
# AI_PROVIDER_C_API_KEY=

# --- Toss Securities Adapter credentials (Phase 13) ---
# Confirmed via Toss Securities' official Open API (developers.tossinvest.com,
# generally available since 2026-08-13): OAuth2 Client Credentials grant --
# TOSS_API_KEY is the OAuth client_id, TOSS_API_SECRET is the client_secret,
# TOSS_ACCOUNT_ID is sent as the X-Tossinvest-Account header on every
# account-scoped call. Never filled in here; see
# docs/specifications/PHASE-13-toss-securities-adapter.md "Toss API
# Verification" for what else could/could not be confirmed.
# TOSS_API_KEY=
# TOSS_API_SECRET=
# TOSS_ACCOUNT_ID=

# --- Data providers (Phase 1 - Data Infrastructure) ---
# MARKET_DATA_API_KEY=
# ADR-0164: 2nd/3rd fallback tiers (Stooq, the original secondary, is a
# confirmed permanent dead end -- ADR-0160 -- and needs no key at all).
# TWELVEDATA_API_KEY=
# ALPHAVANTAGE_API_KEY=

# --- Alerting (Phase 14 - Monitoring / Drift / Safety) ---
# **Batch H correction (independent audit item 5): no code reads
# ALERT_WEBHOOK_URL either -- also decorative.** The real, actually-used
# alert channel is DISCORD_WEBHOOK_URL, read by
# scripts/send_discord_notification.py and wired as a GitHub Actions
# repository secret in .github/workflows/paper_trading_cycle.yml (its
# "Send Discord notification" step). Set that one, not this one, to
# actually receive alerts.
# ALERT_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
