# Copy this file to .env and fill in real values locally.
# NEVER commit .env. NEVER hardcode secrets in source code.
# See PROJECT_MASTER_PLAN.md section 14 (Configuration, Secrets, Environment).

# --- Environment selector ---
# One of: development | backtest | paper | live
APP_ENV=development

# Hard safety default. Must be explicitly set to true to allow real broker
# orders. See PROJECT_MASTER_PLAN.md section 14.4.
LIVE_TRADING=false

# --- AI Gateway: provider credentials (references only, not filled here) ---
# Add one variable per provider as providers are actually integrated
# (Phase 12 - AI Gateway). Do not add real keys to this example file.
# AI_PROVIDER_A_API_KEY=
# AI_PROVIDER_B_API_KEY=
# AI_PROVIDER_C_API_KEY=

# --- Toss Securities Adapter credentials (Phase 13) ---
# Confirmed via Toss Securities' official Open API (developers.tossinvest.com,
# generally available since 2026-08-13): OAuth2 Client Credentials grant --
# TOSS_API_KEY is the OAuth client_id, TOSS_API_SECRET is the client_secret,
# TOSS_ACCOUNT_ID is sent as the X-Tossinvest-Account header on every
# account-scoped call. Never filled in here; see
# docs/specifications/PHASE-13-toss-securities-adapter.md "Toss API
# Verification" for what else could/could not be confirmed.
# TOSS_API_KEY=
# TOSS_API_SECRET=
# TOSS_ACCOUNT_ID=

# --- Data providers (Phase 1 - Data Infrastructure) ---
# MARKET_DATA_API_KEY=

# --- Alerting (Phase 14 - Monitoring / Drift / Safety) ---
# ALERT_WEBHOOK_URL=
