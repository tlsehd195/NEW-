#!/bin/bash
# Cloud-init user-data template for the OCI Ampere A1 (ARM) instance
# that hosts a GitHub Actions self-hosted runner for colibri
# (EXTERNAL_REPO_APPLICABILITY_REPORT.md priority 10, CLAUDE.md's own
# tracked pending user action). Never committed with real values --
# .github/workflows/provision_oci_colibri_runner.yml substitutes the
# two placeholders below at provisioning time and passes the result as
# --user-data-file; this template itself has no secret in it.
#
# __REPO_URL__      -- e.g. https://github.com/tlsehd195/NEW-
# __RUNNER_TOKEN__  -- a short-lived (1 hour) runner registration token
#                      fetched fresh by the workflow via the GitHub API
#                      immediately before launching the instance; never
#                      the long-lived GH_RUNNER_PAT secret itself.
set -euo pipefail

RUNNER_USER="ubuntu"
RUNNER_HOME="/home/${RUNNER_USER}/actions-runner"
REPO_URL="__REPO_URL__"
RUNNER_TOKEN="__RUNNER_TOKEN__"

mkdir -p "$RUNNER_HOME"
cd "$RUNNER_HOME"

LATEST_TAG=$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest | grep -o '"tag_name": *"v[^"]*"' | cut -d'"' -f4)
VERSION="${LATEST_TAG#v}"
curl -fsSL -o runner.tar.gz \
  "https://github.com/actions/runner/releases/download/${LATEST_TAG}/actions-runner-linux-arm64-${VERSION}.tar.gz"
tar xzf runner.tar.gz
rm -f runner.tar.gz

chown -R "${RUNNER_USER}:${RUNNER_USER}" "$RUNNER_HOME"

sudo -u "$RUNNER_USER" ./config.sh \
  --url "$REPO_URL" \
  --token "$RUNNER_TOKEN" \
  --name "oci-colibri-runner" \
  --labels "colibri,arm64,oci" \
  --work "_work" \
  --unattended \
  --replace

./svc.sh install "$RUNNER_USER"
./svc.sh start
