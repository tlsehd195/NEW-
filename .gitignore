# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/

# Data / experiment artifacts (large or generated; keep directory via .gitkeep)
data/*
!data/.gitkeep
experiments/*
!experiments/.gitkeep
logs/*
!logs/.gitkeep

# Real market data / broker/database artifacts (Phase 22 instruction section
# 26): this repo holds schema, metadata, checksums, ingestion code, config,
# and docs -- never actual vendor data or a populated database file, no
# matter where in the tree it would otherwise land. Test fixtures use
# pytest's tmp_path (outside the repo tree entirely -- see
# tests/storage_helpers.py), so this is a defense-in-depth backstop, not a
# response to any file these patterns would currently catch (no *.csv/
# *.parquet/*.db/*.duckdb file is tracked in this repo today).
*.duckdb
*.duckdb.wal
*.db
*.parquet
*.csv

# Local overrides
*.local
