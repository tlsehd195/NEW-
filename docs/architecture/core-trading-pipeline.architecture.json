  "cards": [
    {
      "dot": "cyan",
      "title": "Two independent read paths",
      "items": [
        "Regime and Prediction both read from data_infra directly",
        "Neither depends on the other; Decision is where they first meet"
      ]
    },
    {
      "dot": "rose",
      "title": "Never skips the gate",
      "items": [
        "broker_live only fires past kill switch + safety_gate + explicit approval",
        "risk never calls a broker directly \u2014 sizing and execution are separate modules"
      ]
    },
    {
      "dot": "emerald",
      "title": "storage is one shared persistence layer",
      "items": [
        "storage implements the repository protocols trade_journal and data_infra each define (DataRepository, TradeJournalRepository) \u2014 not a separate store per module",
        "learning/evolution read storage only, and only offline; a new model must pass validation again before it can reach decision/predict"
      ]
    }
